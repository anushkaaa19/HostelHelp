# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local example: mongodb://127.0.0.1:27017/hostel_management
# Atlas example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/hostel_management
MONGO_URI=mongodb://127.0.0.1:27017/hostel_management

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# JWT
# Use a long, random string in real deployments (e.g. `openssl rand -hex 32`).
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Used only when running `npm run seed:admin` to create the first admin account.
# Not read by the server itself.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
